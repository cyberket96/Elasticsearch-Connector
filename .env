# Elasticsearch Connection Configuration
# Choose either Self-Hosted OR Elastic Cloud configuration

# ============================================
# DEPLOYMENT TYPE
# ============================================
# Options: "self_hosted" or "elastic_cloud"
# ES_DEPLOYMENT_TYPE=self_hosted

# ============================================
# SELF-HOSTED ELASTICSEARCH
# ============================================
# Uncomment and configure if using self-hosted deployment
# ES_HOST=elasticsearch_host
# ES_PORT=elasticsearch_port
# ES_SCHEME=https/http
# ES_USERNAME=elasticsearch_username
# ES_PASSWORD=elasticsearch_password

# SSL/TLS Settings for Self-Hosted
# ES_VERIFY_CERTS=false
# ES_CA_CERTS=/path/to/ca.crt
# ES_CLIENT_CERT=/path/to/client.crt
# ES_CLIENT_KEY=/path/to/client.key

# ============================================
# ELASTIC CLOUD
# ============================================
# Uncomment and configure if using Elastic Cloud
# ES_CLOUD_ID=your_cloud_id_here
# ES_API_KEY=your_api_key_here

# ============================================
# OPTIONAL SETTINGS
# ============================================
# Request timeout in seconds
ES_TIMEOUT=30

# Maximum number of retries
ES_MAX_RETRIES=3
